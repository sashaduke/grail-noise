fn f32_bits(v: f32) -> u64 {
    // binary32 bits of an f32 (held as the binary64 word of its value)
    b := bits(f64(v));
    sign := b >> 63;
    if (b & 9223372036854775807) == 0 {
        return sign * 2147483648;
    }
    // normal binary32 values only (the noise outputs are well inside the normal range)
    exp := ((b >> 52) & 2047) + 127 - 1023;
    mant := (b >> 29) & 8388607;
    return sign * 2147483648 + exp * 8388608 + mant;
}

